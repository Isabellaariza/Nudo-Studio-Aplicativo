# ── Supabase ──────────────────────────────────────────────────
# Encuéntralas en: Supabase → Settings → Database → Connection string
# Elige el modo "URI" y copia la cadena completa
DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.[TU-REF].supabase.co:5432/postgres

# ── JWT ───────────────────────────────────────────────────────
# Genera una clave segura: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_segura
JWT_EXPIRES_IN=8h

# ── Servidor ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Frontend (CORS) ───────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
